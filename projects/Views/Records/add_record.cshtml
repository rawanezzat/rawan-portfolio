@using Credit2.Core.ViewModels
@model CreateRecordViewModel
@{
    ViewData["Title"] = " Record";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Card Header -->
            <div class="card shadow-sm rounded-3 mb-4">
                <div class="card-header bg-light-primary border border-primary border-2 border-dashed py-3 px-4">
                    <div class="d-flex align-items-center">
                        <span class="svg-icon svg-icon-2 svg-icon-primary me-3">
                            <!-- Shield/Security Icon -->
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path opacity="0.3" d="M20.5543 4.37824L12.1798 2.02473C12.0626 1.99176 11.9376 1.99176 11.8203 2.02473L3.44572 4.37824C3.18118 4.45258 3 4.6807 3 4.93945V13.569C3 14.6914 3.48509 15.8404 4.4417 16.984C5.17231 17.8575 6.18314 18.7345 7.446 19.5909C9.56752 21.0295 11.6566 21.912 11.7445 21.9488C11.8258 21.9829 11.9129 22 12.0001 22C12.0872 22 12.1744 21.983 12.2557 21.9488C12.3435 21.912 14.4326 21.0295 16.5541 19.5909C17.8169 18.7345 18.8277 17.8575 19.5584 16.984C20.515 15.8404 21 14.6914 21 13.569V4.93945C21 4.6807 20.8189 4.45258 20.5543 4.37824Z" fill="currentColor" />
                                <path d="M12.0006 11.1542C13.1434 11.1542 14.0777 10.22 14.0777 9.0771C14.0777 7.93424 13.1434 7 12.0006 7C10.8577 7 9.92348 7.93424 9.92348 9.0771C9.92348 10.22 10.8577 11.1542 12.0006 11.1542Z" fill="currentColor" />
                            </svg>
                        </span>
                        <h5 class="mb-0 fw-bold">Add New Record</h5>
                    </div>
                </div>
                <!-- Card body would go here if needed -->
                <!-- <div class="card-body">
                    Your form or content here
                </div> -->
            </div>
            <!-- Display validation summary -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <strong>Please fix the following errors:</strong>
                    <div asp-validation-summary="All" class="text-danger"></div>
                </div>
            }

            <!-- Form Card -->
            <div class="card shadow-sm rounded-3">
                <div class="card-body p-5">
                    <form asp-controller="Records" asp-action="Create" method="post" enctype="multipart/form-data" id="recordForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="UserCardId" id="UserCardId" />

                        <div class="row g-4">
                            <!-- Holder - Required -->
                            <div class="col-md-12">
                                <label class="form-label fw-semibold">
                                    Holder <span class="text-danger">*</span>
                                </label>
                                <select asp-for="HolderId" asp-items="ViewBag.Holders" id="holderSelect"
                                        class="form-select form-select-lg form-select-solid">
                                    <option value="">-- Select Holder --</option>
                                </select>
                                <span asp-validation-for="HolderId" class="text-danger"></span>
                            </div>

                            <!-- Card Information - Auto-filled, Readonly -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Card Number</label>
                                <input type="text" id="cardNumberInput" class="form-control form-control-lg form-control-solid"
                                       readonly placeholder="Select holder to see card" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Bank</label>
                                <input type="text" id="bankInput" class="form-control form-control-lg form-control-solid"
                                       readonly placeholder="Bank name will appear here" />
                            </div>

                            <!-- Statement Date - Required -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">
                                    Statement Date <span class="text-danger">*</span>
                                </label>
                                <input asp-for="StatementDate" type="date" class="form-control form-control-lg"
                                       max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="StatementDate" class="text-danger"></span>
                            </div>

                            <!-- Description - Optional -->
                            <div class="col-12">
                                <label class="form-label fw-semibold">Description </label>
                                <textarea asp-for="Description" class="form-control form-control-lg" rows="3"
                                          placeholder="Enter description..."></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <!-- Comment - Optional -->
                            <div class="col-12">
                                <label class="form-label fw-semibold">Comment </label>
                                <textarea asp-for="AccountantComment" class="form-control form-control-lg" rows="3"
                                          placeholder="Enter comments..."></textarea>
                                <span asp-validation-for="AccountantComment" class="text-danger"></span>
                            </div>

                            <!-- File Upload - Optional -->
                            <div class="col-12">
                                <label class="form-label fw-semibold">Attachment </label>
                                <input asp-for="AccountantFile" type="file" class="form-control form-control-lg"
                                       accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png" />
                                <small class="text-muted">
                                    Accepted formats: PDF, Word, Excel, Images (Max 5MB)
                                </small>
                            </div>

                            <!-- Buttons -->
                            <div class="col-12 d-flex justify-content-end mt-4">
                                <a asp-action="Index" class="btn btn-light btn-lg me-3">Cancel</a>
                                <button type="submit" class="btn btn-primary btn-lg" id="submitBtn">
                                    <span id="submitText">Save Record</span>
                                    <span id="spinner" class="spinner-border spinner-border-sm d-none"></span>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function() {
            // Handle holder selection change - auto-fill card
            $("#holderSelect").change(function() {
                var holderId = $(this).val();

                // Clear card info
                $("#cardNumberInput").val("");
                $("#bankInput").val("");
                $("#UserCardId").val("");

                if (holderId) {
                    $.ajax({
                        url: '@Url.Action("GetHolderCard", "Records")',
                        type: 'GET',
                        data: { holderId: holderId },
                        success: function(card) {
                            if (card) {
                                $("#cardNumberInput").val(card.cardNumber);
                                $("#bankInput").val(card.bank);
                                $("#UserCardId").val(card.id);
                            } else {
                                $("#cardNumberInput").val("No card found for this holder");
                                $("#bankInput").val("Please add a card first");
                                alert("This holder does not have any cards. Please add a card for this holder first.");
                            }
                        },
                        error: function() {
                            alert("Error loading card information. Please try again.");
                        }
                    });
                }
            });

            // Form submission handler
            $("#recordForm").submit(function() {
                // Validate that card exists
                if (!$("#UserCardId").val()) {
                    alert("Please select a holder that has a valid card.");
                    return false;
                }

                $("#submitBtn").prop("disabled", true);
                $("#submitText").text("Saving...");
                $("#spinner").removeClass("d-none");
            });
        });
    </script>

    <style>
        .form-control-lg, .form-select-lg {
            padding: 0.75rem 1rem;
            font-size: 1rem;
        }

        .btn-lg {
            padding: 0.75rem 1.5rem;
            font-size: 1rem;
        }

        .border-dashed {
            border-style: dashed !important;
        }

        .bg-light-primary {
            background-color: rgba(13, 110, 253, 0.1);
        }
    </style>
}