@using Credit2.Core.ViewModels
@model HolderDetailsViewModel
@{
    ViewData["Title"] = "Add Holder Details";
}

<div class="container-xxl mt-5">
    <!-- Holder Details Phase -->
    <div class="card card-flush shadow-sm">
        <div class="card-header justify-content-center bg-light-primary">
            <h3 class="card-title fw-bolder mb-0" style="color: #00C851">
                Holder Details Phase
            </h3>
        </div>

        <div class="card-body">
       

            <!-- Accountant Fields - Data from Database -->
            <div class="card card-bordered mb-7">
                <div class="card-header bg-light-primary justify-content-center">
                    <h4 class="card-title text-primary fw-bolder mb-0" style="color: #00C851">
                        Accountant Fields 
                    </h4>
                </div>

                <div class="card-body">
                    <div class="row g-5 mb-5">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Holder</label>
                            <input type="text" class="form-control form-control-solid"
                                   value="@Model.HolderName" disabled />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Bank</label>
                            <input type="text" class="form-control form-control-solid"
                                   value="@Model.BankName" disabled />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Card Number</label>
                            <input type="text" class="form-control form-control-solid"
                                   value="@Model.CardNumber" disabled />
                        </div>
                    </div>

                    <div class="row g-5 mb-5">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Description</label>
                            <input type="text" class="form-control form-control-solid"
                                   value="@Model.Description" disabled />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Statement Date</label>
                            <input type="text" class="form-control form-control-solid"
                                   value="@Model.StatementDate.ToString("dd MMM, yyyy")" disabled />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Accountant Comment</label>
                            <input type="text" class="form-control form-control-solid"
                                   value="@Model.AccountantComment" disabled />
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.AccountantFileUrl))
                    {
                        <div>
                            <a href="@Model.AccountantFileUrl" target="_blank" class="text-primary fw-bold">
                                <i class="fas fa-file-pdf me-2"></i>@Model.HolderName @Model.BankName Statement.pdf
                            </a>
                        </div>
                    }
                </div>
            </div>

            <!-- Holder Fields - Editable -->
            <form asp-action="SaveDetails" asp-controller="Holders" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="RecordId" />
                <input type="hidden" asp-for="CurrentPhase" />

                <div class="card card-bordered">
                    <div class="card-header bg-light-primary justify-content-center">
                        <h4 class="card-title text-primary fw-bolder mb-0" style="color: #00C851">
                            Holder Fields (Add Your Details)
                        </h4>
                    </div>

                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table align-middle table-row-dashed fs-6 gy-5">
                                <thead>
                                    <tr class="text-gray-400 fw-bold fs-7 text-uppercase">
                                        <th>Date *</th>
                                        <th>Comment *</th>
                                        <th>Amount *</th>
                                        <th>Currency *</th>
                                        <th>Cost Center *</th>
                                        <th>Expenses *</th>
                                        <th>Invoice</th>
                                        <th>File</th>
                                        <th class="text-end">
                                            <button type="button" class="btn btn-icon btn-light-success btn-sm" onclick="addRow()">
                                                <i class="fas fa-plus"></i>
                                            </button>
                                        </th>
                                    </tr>
                                </thead>

                                <tbody id="holderTableBody">
                                    @for (int i = 0; i < Model.HolderFields.Count; i++)
                                    {
                                        <tr>
                                            <td>
                                                <input type="date" asp-for="@Model.HolderFields[i].Date"
                                                       class="form-control form-control-sm form-control-solid" />
                                                <span asp-validation-for="@Model.HolderFields[i].Date" class="text-danger small"></span>
                                            </td>
                                            <td>
                                                <input type="text" asp-for="@Model.HolderFields[i].Comment"
                                                       class="form-control form-control-sm form-control-solid"
                                                       placeholder="Enter comment" />
                                                <span asp-validation-for="@Model.HolderFields[i].Comment" class="text-danger small"></span>
                                            </td>
                                            <td>
                                                <input type="number" step="0.01" asp-for="@Model.HolderFields[i].Amount"
                                                       class="form-control form-control-sm form-control-solid"
                                                       placeholder="0.00" />
                                                <span asp-validation-for="@Model.HolderFields[i].Amount" class="text-danger small"></span>
                                            </td>
                                            <td>
                                                <select asp-for="@Model.HolderFields[i].Currency"
                                                        class="form-select form-select-sm form-select-solid">
                                                    <option value="EGP">EGP</option>
                                                    <option value="USD">USD</option>
                                                    <option value="EUR">EUR</option>
                                                </select>
                                            </td>
                                            <td>
                                                <select asp-for="@Model.HolderFields[i].CostCenter"
                                                        class="form-select form-select-sm form-select-solid">
                                                    <option value="">Select</option>
                                                    <option value="Sales">Sales</option>
                                                    <option value="Admin">Admin</option>
                                                    <option value="Marketing">Marketing</option>
                                                    <option value="R&D">R&D</option>
                                                    <option value="Operations">Operations</option>
                                                    <option value="IT">IT</option>
                                                    <option value="HR">HR</option>
                                                </select>
                                            </td>
                                            <td>
                                                <select asp-for="@Model.HolderFields[i].Expenses"
                                                        class="form-select form-select-sm form-select-solid">
                                                    <option value="">Select</option>
                                                    <option value="Travel">Travel</option>
                                                    <option value="Stationery">Stationery</option>
                                                    <option value="Meals">Meals</option>
                                                    <option value="Accommodation">Accommodation</option>
                                                    <option value="Transportation">Transportation</option>
                                                    <option value="Utilities">Utilities</option>
                                                    <option value="Training">Training</option>
                                                    <option value="Software">Software</option>
                                                    <option value="Other">Other</option>
                                                </select>
                                            </td>
                                            <td>
                                                <input type="text" asp-for="@Model.HolderFields[i].Invoice"
                                                       class="form-control form-control-sm form-control-solid"
                                                       placeholder="Invoice #" />
                                            </td>
                                            <td>
                                                <input type="file" asp-for="@Model.HolderFields[i].File"
                                                       class="form-control form-control-sm"
                                                       accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx" />
                                                @if (!string.IsNullOrEmpty(Model.HolderFields[i].FileUrl))
                                                {
                                                    <small>
                                                        <a href="@Model.HolderFields[i].FileUrl" target="_blank">View</a>
                                                    </small>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <button type="button" class="btn btn-icon btn-light-danger btn-sm"
                                                        onclick="removeRow(this)">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>


                        <div class="d-flex justify-content-end mt-5">
                            <button type="submit" class="btn btn-success me-3" id="submitBtn">
                                <i class="fas fa-save me-2"></i>Save Details
                            </button>
            </form>

                            <button type="button" class="btn btn-secondary" onclick="window.location.href='@Url.Action("Index", "Holders")'">
                                <i class="fas fa-times me-2"></i>Cancel
                            </button>
                        </div>
                    </div>
                </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        let rowIndex = @Model.HolderFields.Count;

        function addRow() {
            const tbody = document.getElementById('holderTableBody');
            const newRow = document.createElement('tr');

            newRow.innerHTML = `
                <td>
                    <input type="date" name="HolderFields[${rowIndex}].Date"
                           class="form-control form-control-sm form-control-solid"
                           value="${new Date().toISOString().split('T')[0]}" required />
                </td>
                <td>
                    <input type="text" name="HolderFields[${rowIndex}].Comment"
                           class="form-control form-control-sm form-control-solid"
                           placeholder="Enter comment" required />
                </td>
                <td>
                    <input type="number" step="0.01" name="HolderFields[${rowIndex}].Amount"
                           class="form-control form-control-sm form-control-solid"
                           placeholder="0.00" required />
                </td>
                <td>
                    <select name="HolderFields[${rowIndex}].Currency"
                            class="form-select form-select-sm form-select-solid" required>
                        <option value="EGP">EGP</option>
                        <option value="USD">USD</option>
                        <option value="EUR">EUR</option>
                    </select>
                </td>
                <td>
                    <select name="HolderFields[${rowIndex}].CostCenter"
                            class="form-select form-select-sm form-select-solid" required>
                        <option value="">Select</option>
                        <option value="Sales">Sales</option>
                        <option value="Admin">Admin</option>
                        <option value="Marketing">Marketing</option>
                        <option value="R&D">R&D</option>
                        <option value="Operations">Operations</option>
                        <option value="IT">IT</option>
                        <option value="HR">HR</option>
                    </select>
                </td>
                <td>
                    <select name="HolderFields[${rowIndex}].Expenses"
                            class="form-select form-select-sm form-select-solid" required>
                        <option value="">Select</option>
                        <option value="Travel">Travel</option>
                        <option value="Stationery">Stationery</option>
                        <option value="Meals">Meals</option>
                        <option value="Accommodation">Accommodation</option>
                        <option value="Transportation">Transportation</option>
                        <option value="Utilities">Utilities</option>
                        <option value="Training">Training</option>
                        <option value="Software">Software</option>
                        <option value="Other">Other</option>
                    </select>
                </td>
                <td>
                    <input type="text" name="HolderFields[${rowIndex}].Invoice"
                           class="form-control form-control-sm form-control-solid"
                           placeholder="Invoice #" />
                </td>
                <td>
                    <input type="file" name="HolderFields[${rowIndex}].File"
                           class="form-control form-control-sm"
                           accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx" />
                </td>
                <td class="text-end">
                    <button type="button" class="btn btn-icon btn-light-danger btn-sm"
                            onclick="removeRow(this)">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            `;

            tbody.appendChild(newRow);
            rowIndex++;
        }

        function removeRow(button) {
            const row = button.closest('tr');
            if (document.querySelectorAll('#holderTableBody tr').length > 1) {
                row.remove();
                // Reindex rows
                reindexRows();
            } else {
                alert('At least one row is required.');
            }
        }

        function reindexRows() {
            const rows = document.querySelectorAll('#holderTableBody tr');
            rows.forEach((row, index) => {
                row.querySelectorAll('[name^="HolderFields"]').forEach(input => {
                    input.name = input.name.replace(/\[\d+\]/, `[${index}]`);
                });
            });
            rowIndex = rows.length;
        }

        // Form submission handler
        document.querySelector('form').addEventListener('submit', function(e) {
            const submitBtn = document.getElementById('submitBtn');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Saving...';
            return true;
        });

        // Set default date for new rows
        document.addEventListener('DOMContentLoaded', function() {
            const today = new Date().toISOString().split('T')[0];
            document.querySelectorAll('input[type="date"]').forEach(input => {
                if (!input.value) {
                    input.value = today;
                }
            });
        });
    </script>

    <style>
        .form-control-solid {
            background-color: #f5f8fa;
        }

        .form-control:focus, .form-select:focus {
            border-color: #00C851;
            box-shadow: 0 0 0 0.2rem rgba(0,200,81,0.25);
        }

        .btn-light-success {
            background-color: #e8fff3;
            border-color: #00C851;
            color: #00C851;
        }

            .btn-light-success:hover {
                background-color: #00C851;
                color: white;
            }

        .btn-light-danger {
            background-color: #ffeaea;
            border-color: #f1416c;
            color: #f1416c;
        }

            .btn-light-danger:hover {
                background-color: #f1416c;
                color: white;
            }

        .btn-success {
            background-color: #00C851;
            border-color: #00C851;
        }

            .btn-success:hover {
                background-color: #00a844;
                border-color: #00a844;
            }
    </style>
}