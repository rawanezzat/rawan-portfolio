@using Credit2.Core.ViewModels
@model AuditorDetailsViewModel
@{
    ViewData["Title"] = "Auditor Phase";
}

<div class="container-xxl mt-5">
    <!-- Auditor Review Phase -->
    <div class="card card-flush shadow-sm mb-7">
        <div class="card-header justify-content-center bg-light-primary">
            <h3 class="card-title fw-bolder mb-0" style="color: #00C851">
                Auditor Review Phase
            </h3>
        </div>

        <div class="card-body">
            <!-- Accountant Fields - Read Only -->
            <div class="card card-bordered mb-7">
                <div class="card-header bg-light-primary justify-content-center">
                    <h4 class="card-title text-primary fw-bolder mb-0" style="color: #00C851">
                        Accountant Fields (Read Only)
                    </h4>
                </div>

                <div class="card-body">
                    <div class="row g-5 mb-5">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Holder</label>
                            <input type="text" class="form-control form-control-solid"
                                   value="@Model.HolderName" disabled />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Bank</label>
                            <input type="text" class="form-control form-control-solid"
                                   value="@Model.BankName" disabled />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Card Number</label>
                            <input type="text" class="form-control form-control-solid"
                                   value="@Model.CardNumber" disabled />
                        </div>
                    </div>

                    <div class="row g-5 mb-5">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Description</label>
                            <input type="text" class="form-control form-control-solid"
                                   value="@Model.Description" disabled />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Statement Date</label>
                            <input type="text" class="form-control form-control-solid"
                                   value="@Model.StatementDate.ToString("dd MMM, yyyy")" disabled />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Comment</label>
                            <input type="text" class="form-control form-control-solid"
                                   value="@Model.AccountantComment" disabled />
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.AccountantFileUrl))
                    {
                        <div>
                            <a href="@Model.AccountantFileUrl" target="_blank" class="text-primary fw-bold">
                                @Model.HolderName @Model.BankName Statement.pdf
                            </a>
                        </div>
                    }
                </div>
            </div>

            <!-- Holder Fields - Read Only -->
            <div class="card card-bordered mb-7">
                <div class="card-header bg-light-primary justify-content-center">
                    <h4 class="card-title text-primary fw-bolder mb-0" style="color: #00C851">
                        Holder Fields (Read Only)
                    </h4>
                </div>

                <div class="card-body">
                    @if (Model.HolderFields != null && Model.HolderFields.Any())
                    {
                        <div class="table-responsive">
                            <table class="table align-middle table-row-dashed fs-6 gy-5">
                                <thead>
                                    <tr class="text-gray-400 fw-bold fs-7 text-uppercase">
                                        <th>Date</th>
                                        <th>Comment</th>
                                        <th>Amount</th>
                                        <th>Currency</th>
                                        <th>Cost Center</th>
                                        <th>Expenses</th>
                                        <th>Invoice</th>
                                        <th>File</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var field in Model.HolderFields)
                                    {
                                        <tr>
                                            <td>@field.Date.ToString("dd/MM/yyyy")</td>
                                            <td>@field.Comment</td>
                                            <td>@field.Amount.ToString("N2")</td>
                                            <td>@field.Currency</td>
                                            <td>@field.CostCenter</td>
                                            <td>@field.Expenses</td>
                                            <td>@field.Invoice</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(field.FileUrl))
                                                {
                                                    <a href="@field.FileUrl" target="_blank" class="btn btn-sm btn-light-primary">
                                                        View
                                                    </a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No holder details submitted yet.</p>
                    }
                </div>
            </div>

            <!-- Previous Auditor Fields - Read Only -->
            @if (Model.ExistingAuditorFields != null && Model.ExistingAuditorFields.Any())
            {
                <div class="card card-bordered mb-7">
                    <div class="card-header bg-light-primary justify-content-center">
                        <h4 class="card-title text-primary fw-bolder mb-0" style="color: #00C851">
                            Previous Audit Reviews
                        </h4>
                    </div>

                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table align-middle table-row-dashed fs-6 gy-5">
                                <thead>
                                    <tr class="text-gray-400 fw-bold fs-7 text-uppercase">
                                        <th>Date</th>
                                        <th>Comment</th>
                                        <th>Status</th>
                                        <th>File</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var audit in Model.ExistingAuditorFields)
                                    {
                                        <tr>
                                            <td>@audit.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>@audit.Comment</td>
                                            <td>
                                                @if (audit.Status == "Approved")
                                                {
                                                    <span class="badge badge-success">Approved</span>
                                                }
                                                else if (audit.Status == "Rejected")
                                                {
                                                    <span class="badge badge-danger">Rejected</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-warning">Pending</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(audit.AuditFileUrl))
                                                {
                                                    <a href="@audit.AuditFileUrl" target="_blank" class="btn btn-sm btn-light-primary">
                                                        View
                                                    </a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <!-- Add Auditor Field Form -->
            <!-- Add Auditor Field Form -->
            <form asp-action="SaveAuditorFields" asp-controller="Auditor" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="RecordId" />
                <input type="hidden" asp-for="CurrentPhase" />

                <div class="card card-flush shadow-sm">
                    <div class="card-header justify-content-center bg-light-primary">
                        <h3 class="card-title fw-bolder mb-0" style="color: #00C851">
                            Add Auditor Field
                        </h3>
                    </div>

                    <div class="card-body">
                        <div class="row g-5 mb-5">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Status</label>
                                <select asp-for="AuditorFields[0].Status" class="form-select form-select-solid" required>
                                    <option value="">-- Select Status --</option>
                                    <option value="Approved">✅ Approve</option>
                                    <option value="Rejected">❌ Reject</option>
                                    <option value="Redirect">↩️ Redirect to Holder</option>
                                </select>
                                <span asp-validation-for="AuditorFields[0].Status" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Attach File</label>
                                <input type="file" asp-for="AuditorFields[0].AuditFile"
                                       class="form-control form-control-solid" />
                            </div>
                        </div>

                        <div class="row g-5 mb-5">
                            <div class="col-12">
                                <label class="form-label fw-semibold">Comment</label>
                                <textarea asp-for="AuditorFields[0].Comment"
                                          class="form-control form-control-solid"
                                          rows="3"
                                          placeholder="Enter your audit comment..."></textarea>
                                <span asp-validation-for="AuditorFields[0].Comment" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-end mt-4">
                            <button type="submit" class="btn btn-success me-3">
                                Submit Review
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>